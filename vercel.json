{
  "functions": {
    "api/judgeme-reviews.ts": {
      "includeFiles": "api/_lib/**"
    }
  },
  "redirects": [
    {
      "source": "/homepage",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/collections/:path*",
      "destination": "https://9kihpp-rg.myshopify.com/collections/:path*",
      "permanent": true
    },
    {
      "source": "/products/:path*",
      "destination": "https://9kihpp-rg.myshopify.com/products/:path*",
      "permanent": true
    },
    {
      "source": "/cart",
      "destination": "https://9kihpp-rg.myshopify.com/cart",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/index.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    }
  ],
  "rewrites": [{ "source": "/(.*)", "destination": "/index.html" }]
}

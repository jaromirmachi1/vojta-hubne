{% comment %}
  Vojta Hubne — product info under title (above price)

  Short description (pick one):
    Metafield: custom.short_description (Multi-line text) — best for 1–2 věty
    Tag: vh-desc|Krátký popisek produktu...

  Other tags (Admin → Products → Tags):
    vh-line|Hydratace           → gold chips (• separated)
    vh-meta|50 ml               → trailing | segment on chip row
    vh-spec|Forma|Krém          → spec table
    vh-bullets-title|Aktivní složky v 1 dávce (30 g): → heading above bullets
    vh-bullet|Vegan, bez lepku  → bullet list

  Theme: Product details → Custom Liquid directly below Title (above Price):
    {% render 'vojta-hubne-product-tags' %}
{% endcomment %}

{% liquid
  assign p = product
  if p == blank or p.id == blank
    if closest.product != blank and closest.product.id != blank
      assign p = closest.product
    endif
  endif
%}

{%- if p == blank -%}
  {%- if request.design_mode -%}
    <div class="vh-product-tags vh-product-tags--editor-hint">
      <p><strong>Vojta Hubne product tags</strong> — produkt se nenačetl. Zkuste uložit šablonu a obnovit náhled.</p>
    </div>
  {%- endif -%}
{%- else -%}
  {% liquid
    assign short_description = p.metafields.custom.short_description.value

    assign has_lines = false
    assign has_meta = false
    assign has_specs = false
    assign has_bullets = false
    assign has_desc_tags = false

    for tag in p.tags
      if tag contains 'vh-line|'
        assign has_lines = true
      elsif tag contains 'vh-meta|'
        assign has_meta = true
      elsif tag contains 'vh-spec|'
        assign has_specs = true
      elsif tag contains 'vh-bullet|'
        assign has_bullets = true
      elsif tag contains 'vh-desc|'
        assign has_desc_tags = true
      endif
    endfor

    assign has_short_description = false
    if short_description != blank
      assign has_short_description = true
    elsif has_desc_tags
      assign has_short_description = true
    endif
  %}

  {%- if has_lines or has_meta or has_short_description or has_specs or has_bullets -%}
    <div class="vh-product-tags">
      {%- if has_lines or has_meta -%}
        <p class="vh-product-tags__line">
          {%- assign line_count = 0 -%}
          {%- for tag in p.tags -%}
            {%- if tag contains 'vh-line|' -%}
              {%- assign line_text = tag | remove: 'vh-line|' | strip -%}
              {%- if line_text != blank -%}
                {%- if line_count > 0 -%}
                  <span class="vh-product-tags__sep" aria-hidden="true"> • </span>
                {%- endif -%}
                <span class="vh-product-tags__chip">{{ line_text }}</span>
                {%- assign line_count = line_count | plus: 1 -%}
              {%- endif -%}
            {%- endif -%}
          {%- endfor -%}

          {%- for tag in p.tags -%}
            {%- if tag contains 'vh-meta|' -%}
              {%- assign meta_text = tag | remove: 'vh-meta|' | strip -%}
              {%- if meta_text != blank -%}
                <span class="vh-product-tags__meta">{{ meta_text }}</span>
              {%- endif -%}
            {%- endif -%}
          {%- endfor -%}
        </p>
      {%- endif -%}

      {%- if short_description != blank -%}
        <div class="vh-product-tags__short-desc">
          {{ short_description | newline_to_br }}
        </div>
      {%- elsif has_desc_tags -%}
        <div class="vh-product-tags__short-desc">
          {%- for tag in p.tags -%}
            {%- if tag contains 'vh-desc|' -%}
              {%- assign desc_text = tag | remove: 'vh-desc|' | strip -%}
              {%- if desc_text != blank -%}
                <p>{{ desc_text }}</p>
              {%- endif -%}
            {%- endif -%}
          {%- endfor -%}
        </div>
      {%- endif -%}

      {%- if has_specs or has_bullets -%}
        <div class="vh-product-tags__grid{% unless has_specs %} vh-product-tags__grid--bullets-only{% endunless %}{% unless has_bullets %} vh-product-tags__grid--specs-only{% endunless %}">
          {%- if has_specs -%}
            <dl class="vh-product-tags__specs">
              {%- for tag in p.tags -%}
                {%- if tag contains 'vh-spec|' -%}
                  {%- assign spec_content = tag | remove: 'vh-spec|' -%}
                  {%- assign spec_parts = spec_content | split: '|' -%}
                  {%- if spec_parts.size >= 2 -%}
                    {%- assign spec_label = spec_parts[0] | strip -%}
                    {%- assign spec_value = spec_parts | slice: 1, spec_parts.size | join: '|' | strip -%}
                    {%- if spec_label != blank and spec_value != blank -%}
                      <div class="vh-product-tags__spec-row">
                        <dt>{{ spec_label }}</dt>
                        <dd>{{ spec_value }}</dd>
                      </div>
                    {%- endif -%}
                  {%- endif -%}
                {%- endif -%}
              {%- endfor -%}
            </dl>
          {%- endif -%}

          {%- if has_bullets -%}
            <div class="vh-product-tags__bullets-wrap">
              {%- for tag in p.tags -%}
                {%- if tag contains 'vh-bullets-title|' -%}
                  {%- assign bullets_title = tag | remove: 'vh-bullets-title|' | strip -%}
                  {%- if bullets_title != blank -%}
                    <p class="vh-product-tags__bullets-title">{{ bullets_title }}</p>
                  {%- endif -%}
                {%- endif -%}
              {%- endfor -%}
              <ul class="vh-product-tags__bullets">
                {%- for tag in p.tags -%}
                  {%- if tag contains 'vh-bullet|' -%}
                    {%- assign bullet_text = tag | remove: 'vh-bullet|' | strip -%}
                    {%- if bullet_text != blank -%}
                      <li>{{ bullet_text }}</li>
                    {%- endif -%}
                  {%- endif -%}
                {%- endfor -%}
              </ul>
            </div>
          {%- endif -%}
        </div>
      {%- endif -%}
    </div>
  {%- elsif request.design_mode -%}
    <div class="vh-product-tags vh-product-tags--editor-hint">
      <p><strong>Vojta Hubne product tags</strong> — u tohoto produktu zatím nejsou data.</p>
      <p><strong>Krátký popis:</strong> metafield <code>custom.short_description</code> nebo tag <code>vh-desc|...</code></p>
      <p><strong>Štítky:</strong> Admin → Produkty → {{ p.title }} → Štítky, např.:</p>
      <ul>
        <li><code>vh-line|Hydratace</code></li>
        <li><code>vh-desc|Proteinový koktejl pro každodenní podporu sytosti.</code></li>
        <li><code>vh-meta|450 g</code></li>
      </ul>
      <p>Blok musí být pod názvem a <strong>nad cenou</strong>. Dlouhý popis nechte v bloku Popis produktu níže.</p>
    </div>
  {%- endif -%}
{%- endif -%}

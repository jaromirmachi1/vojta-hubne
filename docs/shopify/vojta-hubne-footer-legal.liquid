{% comment %}
  Vojta Hubne — footer legal columns + newsletter (matches React SiteFooter).

  Setup: sections/footer.liquid — add BEFORE {% content_for 'blocks' %}:
  {% render 'vojta-hubne-footer-legal', marketing_url: 'https://www.vojtahubne.cz' %}

  Horizon Email signup and default utilities are hidden — this snippet includes
  the React bottom bar (locale, copyright, socials, payment icons).
{% endcomment %}

{% assign marketing = marketing_url | default: 'https://www.vojtahubne.cz' %}

<div class="vh-footer-shell">
<div class="vh-footer-top">
  <div class="vh-footer-legal">
    <div class="vh-footer-legal__column">
      <h2 class="vh-footer-legal__title">Kontaktní informace</h2>
      <p class="vh-footer-legal__company">RM Solution Group s.r.o.</p>
      <p class="vh-footer-legal__text">Žabeň 309, 739 25 Žabeň</p>
      <p class="vh-footer-legal__text">IČO: 29615551</p>
      <p class="vh-footer-legal__text">DIČ: CZ29615551</p>
      <p class="vh-footer-legal__text">Nejsem plátce DPH.</p>
      <p class="vh-footer-legal__text">ID datové schránky: cyauddd</p>
      <p class="vh-footer-legal__text">
        <a class="vh-footer-legal__link" href="mailto:info@vojtahubne.cz">info@vojtahubne.cz</a>
      </p>
    </div>

    <div class="vh-footer-legal__column">
      <h2 class="vh-footer-legal__title">Důležité informace</h2>
      <nav class="vh-footer-legal__nav" aria-label="Důležité informace">
        <a class="vh-footer-legal__link" href="{{ marketing }}/kontakt">Kontakt</a>
        <a class="vh-footer-legal__link" href="{{ marketing }}/#faq">Nejčastější dotazy</a>
        {% if shop.shipping_policy %}
          <a class="vh-footer-legal__link" href="{{ shop.shipping_policy.url }}">Doprava a platba</a>
        {% else %}
          <a class="vh-footer-legal__link" href="{{ routes.root_url }}policies/shipping-policy">Doprava a platba</a>
        {% endif %}
        {% if shop.terms_of_service %}
          <a class="vh-footer-legal__link" href="{{ shop.terms_of_service.url }}">Obchodní podmínky</a>
        {% else %}
          <a class="vh-footer-legal__link" href="{{ routes.root_url }}policies/terms-of-service">Obchodní podmínky</a>
        {% endif %}
        {% if shop.refund_policy %}
          <a class="vh-footer-legal__link" href="{{ shop.refund_policy.url }}">Reklamace</a>
        {% else %}
          <a class="vh-footer-legal__link" href="{{ routes.root_url }}policies/refund-policy">Reklamace</a>
        {% endif %}
        <a class="vh-footer-legal__link" href="{{ routes.root_url }}pages/zasady-ochrany-osobnich-udaju">Zásady ochrany osobních údajů</a>
        <a class="vh-footer-legal__link" href="{{ routes.root_url }}pages/zasady-pouzivani-cookies">Zásady používání cookies</a>
      </nav>
    </div>
  </div>

  <aside class="vh-footer-newsletter" aria-labelledby="vh-footer-newsletter-title">
    <h2 class="vh-footer-newsletter__title" id="vh-footer-newsletter-title">Buďte u toho s námi</h2>
    <p class="vh-footer-newsletter__text">
      Tipy, novinky, nové produkty, zákulisí vývoje a občas Karel z expedice. Bez každodenního spamu.
    </p>

    {% form 'customer', id: 'vh-footer-newsletter-form', class: 'vh-footer-newsletter__form' %}
      <input type="hidden" name="contact[tags]" value="newsletter, website-footer">
      <input type="hidden" name="contact[accepts_marketing]" value="true">

      {% if form.posted_successfully? %}
        <p class="vh-footer-newsletter__status" role="status">
          Děkujeme, e-mail je přihlášen k odběru.
        </p>
      {% elsif form.errors %}
        <p class="vh-footer-newsletter__status vh-footer-newsletter__status--error" role="alert">
          Nepodařilo se e-mail přihlásit. Zkuste to prosím znovu.
        </p>
      {% endif %}

      <div class="vh-footer-newsletter__fields">
        <input
          class="vh-footer-newsletter__input"
          type="email"
          name="contact[email]"
          autocomplete="email"
          placeholder="E-mailová adresa"
          aria-label="E-mailová adresa"
          required
        >
        <button class="vh-footer-newsletter__button" type="submit">
          Chci novinky
        </button>
      </div>
    {% endform %}

    <p class="vh-footer-newsletter__consent">
      Odesláním souhlasíte se
      <a href="{{ routes.root_url }}pages/zasady-ochrany-osobnich-udaju">zpracováním osobních údajů</a>.
    </p>
  </aside>
</div>

  <div class="vh-footer-bottom">
    <div class="vh-footer-bottom__left">
      <p class="vh-footer-bottom__locale">🇨🇿 Česko (CZK Kč)</p>
      <p class="vh-footer-bottom__copy">© {{ 'now' | date: '%Y' }} Vojta Hubne · RM Solution Group s.r.o.</p>
    </div>

    <div class="vh-footer-bottom__right">
      <div class="vh-footer-bottom__socials">
        <a
          class="vh-footer-bottom__social"
          href="https://www.facebook.com/share/g/183Ks7Zm9S/?mibextid=wwXIfr"
          target="_blank"
          rel="noopener noreferrer"
          aria-label="Facebook"
        >
          <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M14 8.5h2.5l-.35 2.5H14v7.5h-3v-7.5H9V8.5h2V6.8c0-2.2 1.3-3.4 3.3-3.4.95 0 1.75.07 1.95.1v2.25h-1.35c-1 0-1.2.5-1.2 1.2V8.5Z"></path>
          </svg>
        </a>
        <a
          class="vh-footer-bottom__social"
          href="https://www.instagram.com/vojtahubne/"
          target="_blank"
          rel="noopener noreferrer"
          aria-label="Instagram"
        >
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true">
            <rect x="4.5" y="4.5" width="15" height="15" rx="4"></rect>
            <circle cx="12" cy="12" r="3.4"></circle>
            <circle cx="16.7" cy="7.3" r="0.8" fill="currentColor" stroke="none"></circle>
          </svg>
        </a>
      </div>

      <ul class="vh-footer-bottom__payments" aria-label="Akceptované platební metody">
        {%- assign vh_payments = shop.enabled_payment_types -%}
        {%- if vh_payments.size == 0 -%}
          {%- assign vh_payments = 'apple_pay,google_pay,shopify_pay,visa,master' | split: ',' -%}
        {%- endif -%}
        {%- for type in vh_payments -%}
          <li class="vh-footer-bottom__payment">
            {{ type | payment_type_svg_tag }}
          </li>
        {%- endfor -%}
      </ul>
    </div>
  </div>
</div>

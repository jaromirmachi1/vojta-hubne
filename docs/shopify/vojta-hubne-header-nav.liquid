{% comment %}
  Vojta Hubne custom Shopify header — mirrors React SiteHeader.

  Setup:
  1. Shopify Admin → Content → Files / Theme assets: upload VojtHLogo.png
  2. Save this file as snippets/vojta-hubne-header-nav.liquid
  3. In sections/header.liquid, render it instead of the default header markup:
     {% render 'vojta-hubne-header-nav', marketing_url: 'https://www.vojtahubne.cz' %}
  4. Load assets/vojta-hubne-horizon.css in layout/theme.liquid.
{% endcomment %}

{% assign marketing = marketing_url | default: 'https://www.vojtahubne.cz' %}
{% assign catalog_url = routes.all_products_collection_url %}
{% if catalog_url == blank %}
  {% assign catalog_url = '/collections/all' %}
{% endif %}
{% comment %} Default catalog sort = most ordered (best-selling) {% endcomment %}
{% unless catalog_url contains 'sort_by=' %}
  {% if catalog_url contains '?' %}
    {% assign catalog_url = catalog_url | append: '&sort_by=best-selling' %}
  {% else %}
    {% assign catalog_url = catalog_url | append: '?sort_by=best-selling' %}
  {% endif %}
{% endunless %}
{% assign cart_url = routes.cart_url %}
{% assign account_url = routes.account_url | default: '/account' %}
{% assign blog_url = '/blogs/blog' %}

<div class="vh-shop-header">
  <div class="vh-shop-header__inner">
    <a class="vh-shop-header__logo-link" href="{{ marketing }}" aria-label="Vojta Hubne — domů">
      <img
        class="vh-shop-header__logo"
        src="{{ 'VojtHLogo.png' | asset_url }}"
        alt="Vojta Hubne"
        width="1196"
        height="382"
        loading="eager"
      >
    </a>

    <nav class="vh-shop-header__nav" aria-label="Hlavní navigace">
      <a class="vh-shop-header__nav-link" href="{{ catalog_url }}">Produkty</a>
      <a class="vh-shop-header__nav-link" href="{{ blog_url }}">Blog</a>
      <a class="vh-shop-header__nav-link" href="{{ marketing }}/#porovnani">Proč my</a>
      <a class="vh-shop-header__nav-link" href="{{ marketing }}/co-chystame">Co chystáme</a>
      <a class="vh-shop-header__nav-link" href="{{ marketing }}/kontakt">Kontakt</a>
    </nav>

    <div class="vh-shop-header__actions">
      <a class="vh-shop-header__account-link" href="{{ account_url }}" aria-label="Přihlásit se / účet">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
          <circle cx="12" cy="8" r="3.25"></circle>
          <path d="M5.5 19.5c1.6-3.2 4-4.75 6.5-4.75s4.9 1.55 6.5 4.75"></path>
        </svg>
      </a>

      <a class="vh-shop-header__cart-link" href="{{ cart_url }}" aria-label="Košík">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
          <path d="M6 6h15l-1.5 9h-12L6 6z"></path>
          <path d="M6 6L5 3H2"></path>
          <circle cx="9" cy="20" r="1"></circle>
          <circle cx="18" cy="20" r="1"></circle>
        </svg>
        {% if cart.item_count > 0 %}
          <span class="vh-shop-header__cart-count" aria-label="{{ cart.item_count }} položek v košíku">
            {{ cart.item_count }}
          </span>
        {% endif %}
      </a>

      <button
        class="vh-shop-header__menu-toggle"
        type="button"
        data-vh-menu-toggle
        aria-label="Otevřít menu"
        aria-expanded="false"
        aria-controls="vh-mobile-nav"
      >
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
          <path d="M4 7h16M4 12h16M4 17h16"></path>
        </svg>
      </button>
    </div>
  </div>

  <div
    id="vh-mobile-nav"
    class="vh-mobile-nav"
    data-vh-mobile-nav
    role="dialog"
    aria-modal="true"
    aria-label="Mobilní navigace"
    hidden
  >
    <button class="vh-mobile-nav__close" type="button" data-vh-menu-close aria-label="Zavřít menu">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" aria-hidden="true">
        <path d="M6 6l12 12M18 6L6 18"></path>
      </svg>
    </button>

    <nav class="vh-mobile-nav__links" aria-label="Hlavní navigace">
      <a class="vh-mobile-nav__link" href="{{ catalog_url }}">Produkty</a>
      <a class="vh-mobile-nav__link" href="{{ blog_url }}">Blog</a>
      <a class="vh-mobile-nav__link" href="{{ marketing }}/#porovnani">Proč my</a>
      <a class="vh-mobile-nav__link" href="{{ marketing }}/co-chystame">Co chystáme</a>
      <a class="vh-mobile-nav__link" href="{{ marketing }}/kontakt">Kontakt</a>
      <a class="vh-mobile-nav__link" href="{{ account_url }}">
        {% if customer %}Můj účet{% else %}Přihlásit se{% endif %}
      </a>
    </nav>

    <footer class="vh-mobile-nav__footer">
      <hr class="vh-mobile-nav__rule">
      <div class="vh-mobile-nav__footer-row">
        <a
          class="vh-mobile-nav__footer-link vh-mobile-nav__footer-link--instagram"
          href="https://www.instagram.com/vojtahubne/"
          target="_blank"
          rel="noopener noreferrer"
        >
          Instagram
        </a>
        <a class="vh-mobile-nav__footer-link" href="{{ marketing }}">vojta-hubne.cz</a>
      </div>
    </footer>
  </div>
</div>

<script>
  (function () {
    const header = document.querySelector('.vh-shop-header');
    if (!header) return;

    const toggle = header.querySelector('[data-vh-menu-toggle]');
    const overlay = header.querySelector('[data-vh-mobile-nav]');
    if (!toggle || !overlay) return;

    document.body.appendChild(overlay);

    const closeButtons = overlay.querySelectorAll('[data-vh-menu-close]');
    const links = overlay.querySelectorAll(
      '.vh-mobile-nav__link, .vh-mobile-nav__footer-link',
    );
    const cartLinks = header.querySelectorAll(
      'a.vh-shop-header__cart-link, a[href="/cart"], a[href*="/cart"]',
    );

    let scrollPosition = 0;

    /**
     * Facebook / Instagram in-app browsers often restore /cart from bfcache
     * with body still position:fixed from the open menu → blue load bar then
     * blank black screen. Never use position:fixed for the lock.
     */
    const clearBodyLockStyles = () => {
      document.documentElement.classList.remove('vh-mobile-nav-open');
      document.body.classList.remove('vh-mobile-nav-open');
      document.documentElement.style.overflow = '';
      document.body.style.position = '';
      document.body.style.top = '';
      document.body.style.left = '';
      document.body.style.right = '';
      document.body.style.width = '';
      document.body.style.overflow = '';
      document.body.style.touchAction = '';
    };

    const forceCloseAllNavs = () => {
      document.querySelectorAll('.vh-mobile-nav').forEach((nav) => {
        nav.hidden = true;
        nav.classList.remove('is-open');
        nav.setAttribute('aria-hidden', 'true');
      });
      document.querySelectorAll('[data-vh-menu-toggle]').forEach((btn) => {
        btn.setAttribute('aria-expanded', 'false');
        btn.setAttribute('aria-label', 'Otevřít menu');
      });
      clearBodyLockStyles();
    };

    const lockScroll = () => {
      scrollPosition = window.scrollY || window.pageYOffset || 0;
      document.documentElement.classList.add('vh-mobile-nav-open');
      document.body.classList.add('vh-mobile-nav-open');
      document.documentElement.style.overflow = 'hidden';
      document.body.style.overflow = 'hidden';
      document.body.style.touchAction = 'none';
    };

    const unlockScroll = () => {
      clearBodyLockStyles();
      if (scrollPosition) {
        window.scrollTo(0, scrollPosition);
      }
    };

    const setOpen = (open) => {
      overlay.hidden = !open;
      overlay.classList.toggle('is-open', open);
      overlay.setAttribute('aria-hidden', open ? 'false' : 'true');
      toggle.setAttribute('aria-expanded', open ? 'true' : 'false');
      toggle.setAttribute('aria-label', open ? 'Zavřít menu' : 'Otevřít menu');

      if (open) {
        lockScroll();
      } else {
        unlockScroll();
      }
    };

    // Always start closed — prevents black overlay after FB in-app bfcache / navigation
    forceCloseAllNavs();
    setOpen(false);

    toggle.addEventListener('click', () => {
      setOpen(!overlay.classList.contains('is-open'));
    });

    closeButtons.forEach((button) => {
      button.addEventListener('click', () => setOpen(false));
    });

    links.forEach((link) => {
      link.addEventListener('click', () => setOpen(false));
    });

    // Close + unlock BEFORE navigating to cart (critical for FB WebView)
    cartLinks.forEach((link) => {
      link.addEventListener(
        'click',
        () => {
          forceCloseAllNavs();
        },
        true,
      );
    });

    window.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && overlay.classList.contains('is-open')) {
        setOpen(false);
      }
    });

    const hardenClose = () => forceCloseAllNavs();
    window.addEventListener('pagehide', hardenClose);
    window.addEventListener('pageshow', hardenClose);
    window.addEventListener('freeze', hardenClose);
    document.addEventListener('visibilitychange', () => {
      if (document.visibilityState === 'hidden') hardenClose();
      if (document.visibilityState === 'visible') hardenClose();
    });

    // Extra pass after paint — FB sometimes restores overlay after first script tick
    window.setTimeout(hardenClose, 0);
    window.setTimeout(hardenClose, 250);
  })();
</script>

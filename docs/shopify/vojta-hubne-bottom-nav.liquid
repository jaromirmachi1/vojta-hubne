{% comment %}
  Mobile bottom tab bar — matches React MobileBottomNav (/alt + marketing layouts).

  Setup:
  1. Save as snippets/vojta-hubne-bottom-nav.liquid
  2. Re-upload assets/vojta-hubne-horizon.css (includes .vh-bottom-nav styles)
  3. In layout/theme.liquid, before </body>:
     {% render 'vojta-hubne-bottom-nav', marketing_url: 'https://www.vojtahubne.cz' %}
{% endcomment %}

{% assign marketing = marketing_url | default: 'https://www.vojtahubne.cz' %}
{% assign catalog_url = '/collections' %}
{% assign novinky_url = '/blogs/novinky' %}
{% assign club_url = marketing | append: '/klub' %}
{% assign home_url = marketing %}
{% assign path = request.path %}

{% assign products_active = false %}
{% if path contains '/collections' or path contains '/products' or path contains '/search' %}
  {% assign products_active = true %}
{% endif %}

{% assign novinky_active = false %}
{% if path contains '/blogs/novinky' %}
  {% assign novinky_active = true %}
{% endif %}

<nav class="vh-bottom-nav" aria-label="Hlavní navigace">
  <a class="vh-bottom-nav__item" href="{{ home_url }}">
    <span class="vh-bottom-nav__icon" aria-hidden="true">
      <svg viewBox="0 0 24 24" fill="none">
        <path
          d="M4.5 10.75 12 4.5l7.5 6.25V19a1.5 1.5 0 0 1-1.5 1.5h-3.75v-5.25h-4.5V20.5H6A1.5 1.5 0 0 1 4.5 19v-8.25Z"
          stroke="currentColor"
          stroke-width="1.7"
          stroke-linejoin="round"
        ></path>
      </svg>
    </span>
    <span class="vh-bottom-nav__label">Domů</span>
  </a>

  <a
    class="vh-bottom-nav__item{% if products_active %} is-active{% endif %}"
    href="{{ catalog_url }}"
    {% if products_active %}aria-current="page"{% endif %}
  >
    <span class="vh-bottom-nav__icon" aria-hidden="true">
      <svg viewBox="0 0 24 24" fill="none">
        <rect x="3.75" y="3.75" width="7" height="7" rx="1.4" stroke="currentColor" stroke-width="1.7"></rect>
        <rect x="13.25" y="3.75" width="7" height="7" rx="1.4" stroke="currentColor" stroke-width="1.7"></rect>
        <rect x="3.75" y="13.25" width="7" height="7" rx="1.4" stroke="currentColor" stroke-width="1.7"></rect>
        <rect x="13.25" y="13.25" width="7" height="7" rx="1.4" stroke="currentColor" stroke-width="1.7"></rect>
      </svg>
    </span>
    <span class="vh-bottom-nav__label">Produkty</span>
  </a>

  <a class="vh-bottom-nav__item" href="{{ club_url }}">
    <span class="vh-bottom-nav__icon" aria-hidden="true">
      <svg viewBox="0 0 24 24" fill="none">
        <path
          d="M12 3.75 13.7 9.1h5.55l-4.5 3.25 1.72 5.4L12 14.7l-4.47 3.05 1.72-5.4-4.5-3.25H10.3L12 3.75Z"
          stroke="currentColor"
          stroke-width="1.7"
          stroke-linejoin="round"
        ></path>
      </svg>
    </span>
    <span class="vh-bottom-nav__label">VH Club</span>
  </a>

  <a
    class="vh-bottom-nav__item{% if novinky_active %} is-active{% endif %}"
    href="{{ novinky_url }}"
    {% if novinky_active %}aria-current="page"{% endif %}
  >
    <span class="vh-bottom-nav__icon" aria-hidden="true">
      <svg viewBox="0 0 24 24" fill="none">
        <path
          d="M5 5.75h11.5A2.75 2.75 0 0 1 19.25 8.5v9.75H7.5A2.75 2.75 0 0 1 4.75 15.5V6.5A.75.75 0 0 1 5.5 5.75"
          stroke="currentColor"
          stroke-width="1.7"
          stroke-linejoin="round"
        ></path>
        <path
          d="M8.25 9.5h7.5M8.25 12.5h7.5M8.25 15.5H14"
          stroke="currentColor"
          stroke-width="1.7"
          stroke-linecap="round"
        ></path>
      </svg>
    </span>
    <span class="vh-bottom-nav__label">Novinky</span>
  </a>
</nav>

{% comment %}
  Vojta Hubne — product benefits strip.

  Use as a separate Custom Liquid section BELOW Product information
  and ABOVE the main product description section:
    {% render 'vojta-hubne-product-benefits' %}
{% endcomment %}

<section class="vh-product-benefits-section" aria-label="Produktové výhody">
  <div class="vh-product-benefits-section__inner">
    <ul class="vh-product-benefits" role="list">
      <li class="vh-product-benefits__item">
        <span class="vh-product-benefits__icon" aria-hidden="true">
          <svg viewBox="0 0 24 24" focusable="false">
            <path d="M4 7h10v10H4z" />
            <path d="M14 10h3.5l2.5 3v4h-6z" />
            <path d="M7 19a2 2 0 1 0 0-4 2 2 0 0 0 0 4Z" />
            <path d="M17 19a2 2 0 1 0 0-4 2 2 0 0 0 0 4Z" />
          </svg>
        </span>
        <span>
          <strong>Rychlé odeslání</strong>
          <small>Expedice skladových produktů co nejdříve po objednání.</small>
        </span>
      </li>

      <li class="vh-product-benefits__item">
        <span class="vh-product-benefits__icon" aria-hidden="true">
          <svg viewBox="0 0 24 24" focusable="false">
            <path d="M12 3 5 6v5c0 4.6 2.8 7.9 7 10 4.2-2.1 7-5.4 7-10V6z" />
            <path d="m9 12 2 2 4-5" />
          </svg>
        </span>
        <span>
          <strong>Promyšlené složení</strong>
          <small>Vybrané aktivní látky pro každodenní rutinu a dlouhodobý progres.</small>
        </span>
      </li>

      <li class="vh-product-benefits__item">
        <span class="vh-product-benefits__icon" aria-hidden="true">
          <svg viewBox="0 0 24 24" focusable="false">
            <path d="M4 19V5" />
            <path d="M4 19h16" />
            <path d="m7 15 4-4 3 3 5-7" />
          </svg>
        </span>
        <span>
          <strong>Podpora transformace</strong>
          <small>Produkty postavené pro režim, disciplínu a lepší kontrolu návyků.</small>
        </span>
      </li>

      <li class="vh-product-benefits__item">
        <span class="vh-product-benefits__icon" aria-hidden="true">
          <svg viewBox="0 0 24 24" focusable="false">
            <path d="M6 8h12l-1 12H7z" />
            <path d="M9 8a3 3 0 0 1 6 0" />
            <path d="M9 13h6" />
          </svg>
        </span>
        <span>
          <strong>Bezpečný nákup</strong>
          <small>Platba přes Shopify, přehledné doručení a jednoduchý kontakt.</small>
        </span>
      </li>
    </ul>
  </div>
</section>

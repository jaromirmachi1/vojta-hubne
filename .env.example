# Copy to .env for local dev. Add same keys in Vercel → Settings → Environment Variables.

# Level 1 — link products to Shopify (required for shop links)
# Use shop subdomain or myshopify URL (no trailing slash)
VITE_SHOPIFY_STORE_URL=https://shop.vojtahubne.cz

# Level 2 — Storefront API (optional, for syncing products on homepage later)
# VITE_SHOPIFY_STORE_DOMAIN=your-store.myshopify.com
# VITE_SHOPIFY_STOREFRONT_TOKEN=your_storefront_access_token

# Copy to .env for local dev. Add same keys in Vercel → Settings → Environment Variables.

# Public marketing site URL (canonical, OG tags, sitemap)
# VITE_SITE_URL=https://www.vojtahubne.cz

# Public shop URL — used in production (Shopify PDP + SEO)
# Links use VITE_SHOPIFY_STORE_DOMAIN (.myshopify.com) until shop DNS is confirmed
VITE_SHOPIFY_STORE_URL=https://shop.vojtahubne.cz

# Storefront API — Headless channel (Step 1: docs/SHOPIFY-STEP-1.md)
# Domain = myshopify hostname only (e.g. 9kihpp-rg.myshopify.com), not shop.vojtahubne.cz
VITE_SHOPIFY_STORE_DOMAIN=9kihpp-rg.myshopify.com
VITE_SHOPIFY_STOREFRONT_TOKEN=your_storefront_public_token

# Shopify Admin API — server-only, never prefix with VITE.
# Required by /api/newsletter to create/subcribe footer newsletter customers.
SHOPIFY_ADMIN_ACCESS_TOKEN=your_admin_api_access_token

# Alternative auth (Dev Dashboard / newer apps): token generated via client credentials.
# Use these only when SHOPIFY_ADMIN_ACCESS_TOKEN is not available.
# SHOPIFY_CLIENT_ID=your_client_id
# SHOPIFY_CLIENT_SECRET=your_client_secret

# Turn on only after shop.vojtahubne.cz points to Shopify, not Vercel
# VITE_SHOPIFY_USE_CUSTOM_DOMAIN=true

# Optional: shop catalog path for external links (default /collections).
# VITE_SHOPIFY_CATALOG_PATH=/collections

# Optional: Shopify blog index (default /blogs/blog).
# VITE_SHOPIFY_BLOG_PATH=/blogs/blog

# Optional: Storefront API locale for translated product copy (default Czech).
# VITE_SHOPIFY_IN_CONTEXT=@inContext(country: CZ, language: CS)

# Judge.me product reviews — server-only (/api/judgeme-reviews).
# The reviews list endpoint requires the Private API token from Judge.me settings.
JUDGEME_PRIVATE_API_TOKEN=your_judgeme_private_api_token
# Optional fallback if you only have the public token configured.
# JUDGEME_PUBLIC_API_TOKEN=your_judgeme_public_api_token
# Optional; defaults to SHOPIFY_STORE_DOMAIN, VITE_SHOPIFY_STORE_DOMAIN, or 9kihpp-rg.myshopify.com.
# JUDGEME_SHOP_DOMAIN=9kihpp-rg.myshopify.com

# Contact form — server-only (/api/contact via Resend).
# Set all three in Vercel (Production, Preview, Development). Key lives only in Vercel.
# Plain npm run dev won't send mail — use vercel dev with .env.local, or test on deploy.
RESEND_API_KEY=your_resend_api_key
RESEND_FROM_EMAIL=Vojta Hubne <info@vojtahubne.cz>
INQUIRY_TO_EMAIL=info@vojtahubne.cz
